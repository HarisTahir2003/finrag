# Copy to .env and fill in. .env is gitignored.
#   cp .env.example .env

# ---- Required for the LLM and Google embeddings ----
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# ---- Required to download filings from SEC EDGAR ----
# The SEC requires a real contact email in the User-Agent header of every
# request and will rate-limit or block anonymous traffic.
# https://www.sec.gov/os/webmaster-faq#developers
SEC_CONTACT_EMAIL=

# ---- Optional ----
# Where filings and the vector store live. Defaults to ./data (gitignored).
FINRAG_DATA_ROOT=./data

# NOTE: the original notebooks also prompted for TAVILY_API_KEY. No tool ever
# used it, so it has been removed. You do not need a Tavily account.
