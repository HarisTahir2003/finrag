# Copy to .env and fill in. .env is gitignored.
#   cp .env.example .env

# ---- The LLM that answers questions ----
# Pick a provider: "anthropic" (default) or "google". Embeddings are configured
# separately and default to a local model, so only one of these keys is needed.
FINRAG_LLM_BACKEND=anthropic

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# https://aistudio.google.com/app/apikey  (only if FINRAG_LLM_BACKEND=google)
GOOGLE_API_KEY=

# Leave blank to use the cheapest sensible default for the chosen backend:
#   anthropic -> claude-haiku-4-5-20251001
#   google    -> gemini-2.5-flash
FINRAG_CHAT_MODEL=

# ---- Required to download filings from SEC EDGAR ----
# The SEC requires a real contact email in the User-Agent header of every
# request and will rate-limit or block anonymous traffic.
# https://www.sec.gov/os/webmaster-faq#developers
SEC_CONTACT_EMAIL=

# ---- Optional ----
# Where filings and the vector store live. Defaults to ./data (gitignored).
FINRAG_DATA_ROOT=./data

# NOTE: the original notebooks also prompted for TAVILY_API_KEY. No tool ever
# used it, so it has been removed. You do not need a Tavily account.
