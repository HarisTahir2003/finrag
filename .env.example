# Copy to .env and fill in. .env is gitignored.
#   cp .env.example .env

# ---- The LLM that answers questions ----
# One of:
#   open-weight, hosted:  cerebras | groq | openrouter | together | fireworks | deepinfra
#   open-weight, local:   ollama
#   commercial:           anthropic (default) | google | openai
#
#   ollama  open-weight models on your own machine. No key, no rate limit, no
#           cost. Needs `ollama serve` running and the model pulled. A 4B model
#           at 4-bit wants ~3GB of free RAM; long contexts want more.
#   groq    open-weight models (Llama, Qwen, GPT-OSS) on a free developer tier.
#           No card required. Rate limited per minute, so lower
#           FINRAG_RETRIEVAL_K when using it.
#   anthropic / google  commercial APIs, paid per token, most reliable tool calling.
#
# Embeddings are configured separately (FINRAG_EMBEDDINGS) and default to a
# local model, so indexing never costs anything whichever of these you pick.
FINRAG_LLM_BACKEND=anthropic

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# https://aistudio.google.com/app/apikey     (only if backend=google)
GOOGLE_API_KEY=

# Open-weight providers. Set whichever one you picked above; each has a free
# or near-free tier and none needs a card up front.
GROQ_API_KEY=          # https://console.groq.com/keys
CEREBRAS_API_KEY=      # https://cloud.cerebras.ai
OPENROUTER_API_KEY=    # https://openrouter.ai/keys
TOGETHER_API_KEY=      # https://api.together.ai/settings/api-keys
# FIREWORKS_API_KEY=
# DEEPINFRA_API_KEY=

# Fallback used by any OpenAI-compatible backend when its own key is unset.
# FINRAG_LLM_API_KEY=

# Point an OpenAI-compatible backend somewhere else entirely, such as a
# self-hosted vLLM or LM Studio server.
# FINRAG_OPENAI_BASE_URL=http://localhost:8000/v1

# Blank uses the default for the chosen backend:
#   anthropic -> claude-haiku-4-5-20251001
#   google    -> gemini-2.5-flash
#   groq      -> llama-3.3-70b-versatile
#   cerebras  -> gpt-oss-120b
#   ollama    -> qwen3:4b
FINRAG_CHAT_MODEL=

# Ollama only. num_ctx must cover the retrieved chunks plus the agent
# scratchpad; Ollama truncates the prompt silently if it does not.
OLLAMA_BASE_URL=http://localhost:11434
FINRAG_OLLAMA_NUM_CTX=16384

# ---- Required to download filings from SEC EDGAR ----
# The SEC requires a real contact email in the User-Agent header of every
# request and will rate-limit or block anonymous traffic.
# https://www.sec.gov/os/webmaster-faq#developers
SEC_CONTACT_EMAIL=

# ---- Optional ----
# Where filings and the vector store live. Defaults to ./data (gitignored).
FINRAG_DATA_ROOT=./data

# NOTE: the original notebooks also prompted for TAVILY_API_KEY. No tool ever
# used it, so it has been removed. You do not need a Tavily account.
